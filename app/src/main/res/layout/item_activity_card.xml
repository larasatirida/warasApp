<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1C2E"
            tools:text="Meeting tim" />

        <TextView
            android:id="@+id/tvItemDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#9B9FA8"
            tools:text="09:00 - 10:00 (60 mnt)" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="manual"
        android:textSize="11sp"
        android:layout_marginEnd="12dp"
        android:textColor="#5B93F0" />

    <ImageButton
        android:id="@+id/btnEditActivity"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="#999999"
        android:contentDescription="Edit" />

    <ImageButton
        android:id="@+id/btnDeleteActivity"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="#F87171"
        android:contentDescription="Hapus" />

</LinearLayout>
